<%@ Page Title="Tạo hóa đơn" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="TaoHoaDon.aspx.cs" Inherits="QLCHTT_WebForms_Frontend.TaoHoaDon" %>
