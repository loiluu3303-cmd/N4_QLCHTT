<%@ Page Title="Báo cáo thống kê" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="BaoCao.aspx.cs" Inherits="QLCHTT_WebForms_Frontend.BaoCao" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<div class="page-heading"><div><h1>Báo cáo thống kê</h1><p>Tổng hợp số liệu doanh thu, bán hàng và hàng tồn.</p></div></div>

        <div class="row g-3 mb-3"><div class="col-12 col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-label">Doanh thu</div><div class="stat-value"><asp:Label ID="lblDoanhThu" runat="server" /></div><div class="stat-note">Dữ liệu từ database</div></div></div><div class="col-12 col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-label">Hóa đơn</div><div class="stat-value"><asp:Label ID="lblSoHoaDon" runat="server" /></div><div class="stat-note">Tổng số hóa đơn</div></div></div><div class="col-12 col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-label">Sản phẩm đã bán</div><div class="stat-value"><asp:Label ID="lblSanPhamDaBan" runat="server" /></div><div class="stat-note">Dữ liệu từ database</div></div></div><div class="col-12 col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-label">Tồn kho</div><div class="stat-value"><asp:Label ID="lblTonKho" runat="server" /></div><div class="stat-note">Số lượng mẫu</div></div></div></div>
        <div class="panel-card"><div class="panel-header"><div><h5>Bộ lọc báo cáo</h5><p>Chọn khoảng thời gian và loại báo cáo</p></div></div><div class="row g-3"><div class="col-12 col-md-6"><label class="form-label">Từ ngày</label><input class="form-control" placeholder="dd/mm/yyyy" /></div><div class="col-12 col-md-6"><label class="form-label">Đến ngày</label><input class="form-control" placeholder="dd/mm/yyyy" /></div><div class="col-12 col-md-6"><label class="form-label">Loại báo cáo</label><input class="form-control" placeholder="Doanh thu / Sản phẩm / Tồn kho" /></div></div><button type="button" class="btn btn-success mt-3">Xem báo cáo</button><asp:Label ID="lblThongBao" runat="server" CssClass="db-message" Visible="false" />
        <h5 class="mt-4">Sản phẩm bán chạy</h5>
        <div class="table-responsive"><asp:GridView ID="gvData" runat="server" CssClass="table db-grid" GridLines="None" AutoGenerateColumns="true" EmptyDataText="Chưa có dữ liệu bán hàng." /></div></div>
</asp:Content>
